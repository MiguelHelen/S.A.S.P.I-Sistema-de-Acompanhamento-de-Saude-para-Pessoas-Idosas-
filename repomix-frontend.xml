              type="submit"
              disabled={salvando || !idoso}
              className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#1565C0] px-6 py-3 font-medium text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#0A2540] hover:shadow-md disabled:cursor-not-allowed disabled:opacity-70"
            >
              {salvando ? (
                <Loader2 size={18} className="animate-spin" />
              ) : (
                <Save size={18} />
              )}
              {salvando ? "Gravando no banco..." : "Salvar registro"}
            </button>
          </div>
        </form>
      </div>
    </main>
  );
}
</file>

<file path="src/app/dashboard/historico/page.tsx">
"use client";

import { useEffect, useState, useCallback } from "react";
import Link from "next/link";
import DashboardNavbar from "@/components/DashboardNavbar";
import PatientSelector, { Idoso } from "@/components/PatientSelector";
import {
  CalendarDays,
  HeartPulse,
  Pill,
  Plus,
  Filter,
  History,
  Loader2,
} from "lucide-react";

interface EventoHistorico {
  id: string;
  tipo: "sinal_vital" | "medicamento" | "consulta";
  titulo: string;
  descricao: string;
  dataHora: string;
  autor: string;
}

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ||
  "https://perfect-bravery-production-5ce7.up.railway.app";

export default function HistoricoPage() {
  const [idoso, setIdoso] = useState<Idoso | null>(null);
  const [eventos, setEventos] = useState<EventoHistorico[]>([]);
  const [carregando, setCarregando] = useState(false);
  const [perfilUsuario, setPerfilUsuario] = useState("");

  const [categoriaSelecionada, setCategoriaSelecionada] = useState<
    "todos" | "sinal_vital" | "medicamento" | "consulta"
  >("todos");

  const carregarHistorico = useCallback(async (idosoId: string) => {
    setCarregando(true);
    const token = localStorage.getItem("saspi_token");
    const headers = { ...(token && { Authorization: `Bearer ${token}` }) };

    try {
      let resSaude = await fetch(
        `${API_URL}/registro-saude/idoso/${idosoId}`,
        { headers }
      ).catch(() => null);

      if (!resSaude?.ok) {
        resSaude = await fetch(
          `${API_URL}/registro-saude?idoso_id=${idosoId}`,
          { headers }
        ).catch(() => null);
      }

      let resPresc = await fetch(`${API_URL}/prescricao/idoso/${idosoId}`, {
        headers,
      }).catch(() => null);

      if (!resPresc?.ok) {
        resPresc = await fetch(`${API_URL}/prescricao?idoso_id=${idosoId}`, {
          headers,
        }).catch(() => null);
      }

      const eventosUnificados: EventoHistorico[] = [];

      if (resSaude?.ok) {
        const dataSaude = await resSaude.json();
        const arrSaude = Array.isArray(dataSaude)
          ? dataSaude
          : dataSaude.data || [];

        arrSaude
          .filter((item: any) => !item.idoso_id || item.idoso_id === idosoId)
          .forEach((item: any) => {
            const rawDate = item.data_hora || item.created_at;
            const dataFormatada = rawDate
              ? new Date(rawDate).toLocaleString("pt-BR", {
                  dateStyle: "short",
                  timeStyle: "short",
                })
              : "Registro recente";

            const nomeIndicador =
              item.indicador_saude?.nome ||
              item.indicador_nome ||
              "Sinal Vital";
            const unidade =
              item.indicador_saude?.unidade_padrao || item.unidade || "";
            const valorPrincipal =
              item.valor_numerico !== null && item.valor_numerico !== undefined
                ? `${item.valor_numerico} ${unidade}`.trim()
                : `${item.valor_categorico || item.valor || ""} ${unidade}`.trim();

            const complemento =
              item.valor_numerico !== null &&
              item.valor_numerico !== undefined &&
              item.valor_categorico
                ? ` • ${item.valor_categorico}`
                : item.observacao
                  ? ` • ${item.observacao}`
                  : "";

            const autorFormatado =
              item.usuario?.nome ||
              (String(item.origem || "").toUpperCase() === "AUTOMATICO"
                ? "Smartband (Automático)"
                : "Registro Manual");

            eventosUnificados.push({
              id: `saude-${item.id}`,
              tipo: "sinal_vital",
              titulo: nomeIndicador,
              descricao: `${valorPrincipal}${complemento}`,
              dataHora: dataFormatada,
              autor: autorFormatado,
            });
          });
      }

      if (resPresc?.ok) {
        const dataPresc = await resPresc.json();
        const arrPresc = Array.isArray(dataPresc)
          ? dataPresc
          : dataPresc.data || [];

        arrPresc
          .filter((p: any) => !p.idoso_id || p.idoso_id === idosoId)
          .forEach((p: any) => {
            const dataFormatada = p.data_inicio
              ? new Date(p.data_inicio).toLocaleDateString("pt-BR")
              : "Prescrição ativa";

            eventosUnificados.push({
              id: `presc-${p.id}`,
              tipo: "medicamento",
              titulo: p.medicamento?.nome || "Prescrição Medicamentosa",
              descricao: `${p.dosagem || ""} • ${p.frequencia || "Uso contínuo"}`,
              dataHora: dataFormatada,
              autor: p.usuario?.nome || "Equipe Médica",
            });
          });
      }

      setEventos(eventosUnificados);
    } catch {
      setEventos([]);
    } finally {
      setCarregando(false);
    }
  }, []);

  useEffect(() => {
    const userRaw = localStorage.getItem("saspi_user");
    if (userRaw) {
      try {
        const parsed = JSON.parse(userRaw);
        const userData = parsed.user || parsed.usuario || parsed;
        setPerfilUsuario(
          String(userData.perfil || userData.role || "").toUpperCase()
        );
      } catch {}
    }

    const activeElderly = localStorage.getItem("saspi_active_elderly");
    if (activeElderly) {
      try {
        const parsed = JSON.parse(activeElderly);
        setIdoso(parsed);
        if (parsed?.id) {
          carregarHistorico(parsed.id);
        }
      } catch {}
    }
  }, [carregarHistorico]);

  function handleSelectElderly(novo: Idoso) {
    setIdoso(novo);
    if (novo?.id) {
      carregarHistorico(novo.id);
    }
  }

  const eventosFiltrados = eventos.filter(
    (evento) =>
      categoriaSelecionada === "todos" || evento.tipo === categoriaSelecionada
  );

  const podeRegistrar = perfilUsuario !== "FAMILIAR";

  return (
    <main className="min-h-screen bg-[#F2F7FB]">
      <DashboardNavbar />

      <div className="mx-auto max-w-7xl px-4 py-8 md:px-8">
        <div className="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span className="text-sm font-semibold uppercase tracking-wider text-[#26A69A]">
              Prontuário e Rastreabilidade
            </span>

            <h1 className="mt-2 text-3xl font-bold tracking-tight text-[#0A2540] md:text-4xl">
              Histórico de Saúde
            </h1>

            <p className="mt-2 max-w-2xl text-gray-600">
              {idoso ? (
                <>
                  Linha do tempo cronológica com aferições, medicamentos e
                  atendimentos de{" "}
                  <strong className="text-[#0A2540]">{idoso.nome}</strong>.
                </>
              ) : (
                "Selecione um paciente para consultar o histórico clínico."
              )}
            </p>
          </div>

          {podeRegistrar && (
            <Link
              href="/dashboard/historico/novo"
              className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#1565C0] px-5 py-3 font-medium text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#0A2540] hover:shadow-md"
            >
              <Plus size={19} />
              Novo registro
            </Link>
          )}
        </div>

        <div className="mt-6">
          <PatientSelector
            onSelect={handleSelectElderly}
            selectedId={idoso?.id}
          />
        </div>

        <section className="mt-8 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm md:p-8">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex items-center gap-2">
              <History size={20} className="text-[#26A69A]" />
              <h2 className="text-xl font-semibold text-[#0A2540]">
                Linha do Tempo Recente
              </h2>
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <Filter size={16} className="text-gray-400" />
              {[
                { label: "Todos", valor: "todos" },
                { label: "Sinais Vitais", valor: "sinal_vital" },
                { label: "Medicamentos", valor: "medicamento" },
                { label: "Consultas", valor: "consulta" },
              ].map((filtro) => (
                <button
                  key={filtro.valor}
                  type="button"
                  onClick={() =>
                    setCategoriaSelecionada(
                      filtro.valor as
                        | "todos"
                        | "sinal_vital"
                        | "medicamento"
                        | "consulta"
                    )
                  }
                  className={`rounded-xl px-3.5 py-1.5 text-xs font-semibold transition ${
                    categoriaSelecionada === filtro.valor
                      ? "bg-[#1565C0] text-white shadow-sm"
                      : "border border-gray-200 bg-[#FAFCFE] text-gray-600 hover:border-[#BFD8F2] hover:text-[#0A2540]"
                  }`}
                >
                  {filtro.label}
                </button>
              ))}
            </div>
          </div>

          {carregando ? (
            <div className="flex items-center justify-center py-12 text-sm text-gray-500">
              <Loader2 size={24} className="animate-spin text-[#1565C0]" />
              <span className="ml-2">
                Buscando histórico no banco de dados...
              </span>
            </div>
          ) : eventosFiltrados.length > 0 ? (
            <ul className="mt-8 space-y-4">
              {eventosFiltrados.map((evento) => (
                <li
                  key={evento.id}
                  className="flex flex-col gap-4 rounded-2xl border border-gray-100 bg-[#FAFCFE] p-5 transition hover:border-[#BFD8F2] hover:bg-white hover:shadow-sm sm:flex-row sm:items-center sm:justify-between"
                >
                  <div className="flex items-start gap-4">
                    {evento.tipo === "sinal_vital" && (
                      <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#E8F1FB] text-[#1565C0]">
                        <HeartPulse size={24} />
                      </div>
                    )}
                    {evento.tipo === "medicamento" && (
                      <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#E6F4EF] text-[#26A69A]">
                        <Pill size={24} />
                      </div>
                    )}
                    {evento.tipo === "consulta" && (
                      <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#E8F1FB] text-[#1565C0]">
                        <CalendarDays size={24} />
                      </div>
                    )}

                    <div>
                      <p className="font-semibold text-[#0A2540]">
                        {evento.titulo}
                      </p>
                      <p className="mt-0.5 text-xs text-gray-400">
                        {evento.dataHora}
                      </p>
                      <p className="mt-2 text-sm text-gray-600">
                        {evento.descricao}
                      </p>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 sm:text-right">
                    <span className="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-[#1565C0]">
                      Responsável: <strong>{evento.autor}</strong>
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <div className="mt-8 rounded-xl border border-dashed border-gray-200 p-8 text-center text-sm text-gray-500">
              {idoso
                ? `Nenhum registro encontrado para ${idoso.nome} nesta categoria.`
                : "Selecione um paciente para exibir os registros."}
            </div>
          )}
        </section>
      </div>
    </main>
  );
}
</file>

<file path="src/app/dashboard/medicamentos/novo/page.tsx">
"use client";

import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import DashboardNavbar from "@/components/DashboardNavbar";
import type { Idoso } from "@/components/PatientSelector";
import {
  ArrowLeft,
  Clock3,
  Pill,
  Save,
  Loader2,
  CheckCircle2,
  UserCheck,
  AlertCircle,
  ShieldAlert,
} from "lucide-react";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ||
  "https://perfect-bravery-production-5ce7.up.railway.app";

export default function NovoMedicamento() {
  const router = useRouter();
  const [salvando, setSalvando] = useState(false);
  const [sucesso, setSucesso] = useState(false);
  const [erro, setErro] = useState("");
  const [idoso, setIdoso] = useState<Idoso | null>(null);
  const [autorizado, setAutorizado] = useState<boolean | null>(null);
  const [usuarioId, setUsuarioId] = useState<string>("");

  const [formData, setFormData] = useState({
    nome: "",
    dosagem: "",
    horario_primeira_dose: "",
    frequencia: "Uma vez ao dia (24h)",
    orientacoes: "",
  });

  useEffect(() => {
    const userRaw = localStorage.getItem("saspi_user");
    if (userRaw) {
      try {
        const parsed = JSON.parse(userRaw);
        const userData = parsed.user || parsed.usuario || parsed;
        const perfil = String(
          userData.perfil || userData.role || ""
        ).toUpperCase();

        setUsuarioId(userData.id || "");

        if (
          perfil === "MEDICO" ||
          perfil === "ENFERMEIRO" ||
          perfil === "ADMINISTRADOR" ||
          perfil === "ADMIN"
        ) {
          setAutorizado(true);
        } else {
          setAutorizado(false);
        }
      } catch {
        setAutorizado(false);
      }
    } else {
      setAutorizado(false);
    }

    const activeElderly = localStorage.getItem("saspi_active_elderly");
    if (activeElderly) {
      try {
        setIdoso(JSON.parse(activeElderly));
      } catch {}
    }
  }, []);

  async function obterOuCriarMedicamentoId(
    nomeMed: string,
    descricaoMed: string | undefined,
    token: string | null
  ): Promise<string | null> {
    const headersAuth = {
      "Content-Type": "application/json",
      ...(token && { Authorization: `Bearer ${token}` }),
    };

    try {
      const resLista = await fetch(`${API_URL}/medicamento`, {
        headers: headersAuth,
      });
      if (resLista.ok) {
        const lista = await resLista.json();
        if (Array.isArray(lista)) {
          const existente = lista.find(
            (m: any) =>
              String(m.nome || "").toLowerCase() === nomeMed.toLowerCase()
          );
          if (existente?.id) return existente.id;
        }
      }

      const resCriar = await fetch(`${API_URL}/medicamento`, {
        method: "POST",
        headers: headersAuth,
        body: JSON.stringify({
          nome: nomeMed,
          descricao: descricaoMed,
        }),
      });

      if (resCriar.ok) {
        const criado = await resCriar.json();
        if (criado?.id) return criado.id;
      }
    } catch {}

    return null;
  }

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setSalvando(true);
    setErro("");
    setSucesso(false);

    if (!idoso || !idoso.id) {
      setErro(
        "Nenhum idoso ativo selecionado. Selecione um paciente no topo do dashboard."
      );
      setSalvando(false);
      return;
    }

    const token = localStorage.getItem("saspi_token");
    const nomeLimpo = formData.nome.trim();
    const orientacoesLimpas = formData.orientacoes.trim() || undefined;
    const frequenciaCompleta = formData.horario_primeira_dose
      ? `${formData.frequencia} (Início às ${formData.horario_primeira_dose})`
      : formData.frequencia;

    try {
      const medicamentoId = await obterOuCriarMedicamentoId(
        nomeLimpo,
        orientacoesLimpas,
        token
      );

      const payload: Record<string, any> = {
        idoso_id: idoso.id,
        ...(medicamentoId && { medicamento_id: medicamentoId }),
        ...(usuarioId && { usuario_id: usuarioId }),
        ...(!medicamentoId && {
          medicamento: {
            nome: nomeLimpo,
            descricao: orientacoesLimpas,
          },
        }),
        dosagem: formData.dosagem.trim(),
        frequencia: frequenciaCompleta,
        status: "ATIVA",
        data_inicio: new Date().toISOString().split("T")[0],
      };

      const res = await fetch(`${API_URL}/prescricao`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          ...(token && { Authorization: `Bearer ${token}` }),
        },
        body: JSON.stringify(payload),
      });

      const errData = await res.json().catch(() => null);

      if (!res.ok) {
        const msg = Array.isArray(errData?.message)
          ? errData.message.join(", ")
          : errData?.message;
        throw new Error(
          msg || `Erro ${res.status}: Não foi possível registrar a prescrição.`
        );
      }

      setSucesso(true);
      setTimeout(() => {
        router.push("/dashboard/medicamentos");
      }, 1500);
    } catch (err: any) {
      setErro(err.message || "Erro de conexão ao comunicar com a API.");
    } finally {
      setSalvando(false);
    }
  }

  if (autorizado === null) {
    return (
      <main className="min-h-screen bg-[#F2F7FB]">
        <DashboardNavbar />
        <div className="mx-auto max-w-4xl px-4 py-16 text-center text-gray-500">
          <Loader2 size={24} className="mx-auto animate-spin text-[#1565C0]" />
          <p className="mt-2 text-sm font-medium">
            Validando permissões clínicas...
          </p>
        </div>
      </main>
    );
  }

  if (autorizado === false) {
    return (
      <main className="min-h-screen bg-[#F2F7FB]">
        <DashboardNavbar />
        <div className="mx-auto max-w-xl px-4 py-16 text-center">
          <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-rose-600">
            <ShieldAlert size={32} />
          </div>
          <h1 className="mt-4 text-2xl font-bold text-[#0A2540]">
            Acesso Restrito
          </h1>
          <p className="mt-2 text-sm text-gray-600">
            Apenas Médicos e Enfermeiros possuem habilitação para cadastrar
            novas prescrições medicamentosas.
          </p>
          <div className="mt-6">
            <Link
              href="/dashboard/medicamentos"
              className="inline-flex items-center gap-2 rounded-xl bg-[#1565C0] px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-[#0A2540]"
            >
              <ArrowLeft size={16} />
              Voltar para Medicamentos
            </Link>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-[#F2F7FB]">
      <DashboardNavbar />

      <div className="mx-auto max-w-4xl px-4 py-8 md:px-8">
        <Link
          href="/dashboard/medicamentos"
          className="inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-[#1565C0]"
        >
          <ArrowLeft size={17} />
          Voltar para medicamentos
        </Link>

        <div className="mt-8">
          <span className="text-sm font-semibold uppercase tracking-wider text-[#26A69A]">
            Rotina de cuidados
          </span>

          <h1 className="mt-2 text-3xl font-bold tracking-tight text-[#0A2540] md:text-4xl">
            Nova Prescrição
          </h1>

          <p className="mt-2 max-w-2xl text-gray-600">
            Cadastre um novo medicamento para organizar a rotina e os alertas do
            paciente.
          </p>
        </div>

        {erro && (
          <div className="mt-6 flex items-center gap-3 rounded-xl bg-red-50 p-4 text-red-700">
            <AlertCircle size={20} className="shrink-0 text-red-600" />
            <p className="text-sm font-medium">{erro}</p>
          </div>
        )}

        {sucesso && (
          <div className="mt-6 flex items-center gap-3 rounded-xl bg-emerald-50 p-4 text-emerald-800">
            <CheckCircle2 size={20} className="shrink-0 text-emerald-600" />
            <p className="text-sm font-medium">
              Medicamento registrado com sucesso no banco de dados!
              Redirecionando...
            </p>
          </div>
        )}

        {idoso && (
          <div className="mt-6 flex items-center gap-3 rounded-2xl border border-blue-100 bg-[#E8F1FB] p-4 text-[#0A2540]">
            <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-[#1565C0] shadow-sm">
              <UserCheck size={20} />
            </div>
            <div>
              <span className="text-xs font-semibold uppercase tracking-wider text-[#1565C0]">
                Prescrição vinculada ao paciente:
              </span>
              <p className="text-sm font-bold">
                {idoso.nome} ({idoso.idade} anos)
              </p>
            </div>
          </div>
        )}

        <form onSubmit={handleSubmit} className="mt-8 space-y-6">
          <section className="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm md:p-8">
            <div className="flex items-center gap-3 border-b border-gray-100 pb-5">
              <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-[#E6F4EF] text-[#26A69A]">
                <Pill size={22} />
              </div>

              <div>
                <h2 className="font-semibold text-[#0A2540]">
                  Dados da Medicação
                </h2>
                <p className="mt-1 text-sm text-gray-500">
                  Preencha o nome, dosagem e regras de administração.
                </p>
              </div>
            </div>

            <div className="mt-6 grid gap-5 md:grid-cols-2">
              <div className="md:col-span-2">
                <label
                  htmlFor="nome"
                  className="mb-2 block text-sm font-medium text-[#0A2540]"
                >
                  Nome do medicamento *
                </label>
                <input
                  id="nome"
                  type="text"
                  required
                  value={formData.nome}
                  onChange={(e) =>
                    setFormData({ ...formData, nome: e.target.value })
                  }
                  placeholder="Ex.: Losartana Potássica"
                  className="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-800 outline-none transition placeholder:text-gray-400 focus:border-[#1565C0] focus:ring-4 focus:ring-[#1565C0]/10"
                />
              </div>

              <div>
                <label
                  htmlFor="dosagem"
                  className="mb-2 block text-sm font-medium text-[#0A2540]"
                >
                  Dosagem / Concentração *
                </label>
                <input
                  id="dosagem"
                  type="text"
                  required
                  value={formData.dosagem}
                  onChange={(e) =>
                    setFormData({ ...formData, dosagem: e.target.value })
                  }
                  placeholder="Ex.: 50 mg"
