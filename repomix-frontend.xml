            >
              {salvando ? (
                <Loader2 size={18} className="animate-spin" />
              ) : (
                <Save size={18} />
              )}
              {salvando ? "Gravando no banco..." : "Salvar medicamento"}
            </button>
          </div>
        </form>
      </div>
    </main>
  );
}
