<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_blob_top" />

    <ImageView
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/splash_blob_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Logo do SASPI"
            android:src="@drawable/logo_saspi" />

        <TextView
            android:id="@+id/txtSlogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="22dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/saspi_navy" />

            <View
                android:id="@+id/dot2"
                android:layout_width="22dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/saspi_blue" />

            <View
                android:id="@+id/dot3"
                android:layout_width="22dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/saspi_teal_light" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Carregando..."
            android:textColor="@color/saspi_gray"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>